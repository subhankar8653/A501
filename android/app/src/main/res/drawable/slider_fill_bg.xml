<?xml version="1.0" encoding="utf-8"?>
<!-- Premium upgrade: flat blue (#1E88E5) fill ki jagah ab app ke apne gold
     accent (#FFD700) ka vertical gradient — poore player ke accent color
     (buttons, active icons) ke saath match karta hai, alag/off-brand blue
     nahi lagta. 100-200% boost zone ka red fill (slider_fill_boost_bg) waisa
     hi rehta hai taaki "boost active hai" saaf dikhe. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#FFC400"
        android:endColor="#FFE082"
        android:type="linear" />
    <corners android:radius="6dp" />
</shape>
