<?xml version="1.0" encoding="utf-8"?>
<!-- Premium upgrade: flat black pill ki jagah ab subtle dark gradient +
     gold hairline border, taaki "2x" hold-speed badge normal black box
     jaisa na lagkar ek chhota premium capsule jaisa dikhe. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E6000000"
        android:endColor="#CC000000"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#66FFD700" />
</shape>
