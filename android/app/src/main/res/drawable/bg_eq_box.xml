<?xml version="1.0" encoding="utf-8"?>
<!-- Premium upgrade: flat translucent white box → subtle gradient + gold
     hairline border, taaki Equalizer dialog ke andar preset/effect boxes
     bhi baaki premium glass-card language follow karein. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1AFFFFFF"
        android:endColor="#0DFFFFFF"
        android:type="linear" />
    <corners android:radius="16dp" />
    <stroke android:width="0.75dp" android:color="#26FFD700" />
</shape>
