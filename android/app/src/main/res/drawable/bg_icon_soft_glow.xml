<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign #3 (user report: "icon ke upar ek achha sa patla border karo
     taki color change hone par achha se dikhe") — ring opacity 15%->40% aur
     width 1dp->1.2dp, taaki koi bhi accent tint lagane par bhi icon chip ka
     outline saaf, clearly visible rahe (pehle wala ring bahut halka/almost
     invisible tha). Fill same rakha hai (dark glass chip). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#4D000000" />
    <stroke
        android:width="1.2dp"
        android:color="#66FFFFFF" />
</shape>
