<?xml version="1.0" encoding="utf-8"?>
<!-- Premium upgrade: Equalizer dialog pehle flat #1A1A1A rectangle tha
     (default AlertDialog ke saath square/plain dikhta tha). Ab baaki app
     jaisa hi glass-card look — subtle gradient + rounded corners + gold
     hairline border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2A2A2A"
        android:centerColor="#1E1E1E"
        android:endColor="#161616"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke android:width="0.75dp" android:color="#26FFD700" />
</shape>
