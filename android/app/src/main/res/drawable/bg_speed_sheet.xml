<?xml version="1.0" encoding="utf-8"?>
<!-- Playback-speed bottom sheet background — solid near-black (not the
     translucent "frosted" panel used elsewhere), rounded only at the top,
     with a faint gold hairline so it reads as a premium YouTube-style sheet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F20B0B0E" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke android:width="1dp" android:color="#1AFFD700" />
</shape>
