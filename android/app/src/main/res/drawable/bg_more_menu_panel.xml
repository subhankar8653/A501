<?xml version="1.0" encoding="utf-8"?>
<!-- More menu panel background: pehle wala bg_dialog_premium bahut dark/
     near-opaque tha. Ye halka hai — kam opacity ka dark-gray fill + thin
     subtle border, taaki peeche ka video thoda dikhta rahe (frosted-glass
     jaisa feel) lekin icons ke liye phir bhi achha contrast mile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Premium polish: pehle flat #8C1A1A1A solid tha — ab wahi color hi
         hai, bas top se thoda lighter shuru hoke usi color pe settle hota
         hai (halka "glass sheen" jaisa upar se light aa rahi ho), corner-
         radius/stroke bilkul same rehte hain isliye koi clipping risk nahi. -->
    <gradient
        android:angle="270"
        android:startColor="#9E2B2B2B"
        android:centerColor="#8C1A1A1A"
        android:endColor="#8C1A1A1A"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
</shape>
