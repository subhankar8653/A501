<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign #2: same calm dark-glass circle (no bright radial glow, as
     user asked earlier to avoid the "chubh raha hai" glare) but fill/ring
     both bumped up a bit so the hero play/pause button reads as clearly
     premium/gold against any video frame, matching the bolder icon glyphs. -->
