<?xml version="1.0" encoding="utf-8"?>
<!-- Player-wide toast/snackbar background: bg_more_menu_panel jaisa hi
     frosted dark-glass gradient + subtle border, taaki system Toast se
     replace hone wale saare messages (errors, quality change, track info)
     player ke baaki UI (more menu, speed sheet, gesture pill) ke saath
     visually consistent lagein — ab koi bhi feedback platform-default
     grey system toast jaisa alag se "chipka hua" nahi dikhega. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#A82B2B2B"
        android:centerColor="#9E1A1A1A"
        android:endColor="#9E1A1A1A"
        android:type="linear" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
</shape>
