<?xml version="1.0" encoding="utf-8"?>
<!-- Shape fix: bg_icon_circle.xml jaisa hi — round ki jagah ab squircle,
     taaki active/glowing state (lock, loop, shuffle waghera) bhi baaki
     icons ke naye shape-language se match kare. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="24dp"
        android:centerColor="#66FFD700"
        android:endColor="#26FFD700" />
    <stroke
        android:width="1.2dp"
        android:color="#FFD700" />
    <corners android:radius="13dp" />
</shape>
