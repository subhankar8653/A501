<?xml version="1.0" encoding="utf-8"?>
<!--
    MX Player jaisa halka top shadow — flat solid color band nahi, balki
    black se gradually transparent hota hua gradient, taaki title/icons
    padhne layak rahein par ek dikhta hua "black stripe" na bane.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#99000000"
        android:centerColor="#4D000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
