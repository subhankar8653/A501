<?xml version="1.0" encoding="utf-8"?>
<!-- Premium dark single-choice sheet — Quality / Subtitles / Audio track ab
     yahi se khulte hain, plain grey AlertDialog ki jagah. Same "material"
     language jo playback-speed sheet already use karti hai: solid near-black
     gradient + rounded top corners + faint gold hairline (bg_speed_sheet),
     drag handle upar, rows neeche dynamically add hoti hain. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_speed_sheet">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="#4DFFFFFF" />

    <TextView
        android:id="@+id/choiceSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:textColor="#8CFFD700"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <LinearLayout
        android:id="@+id/inlineChoiceRowsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp" />

</LinearLayout>
