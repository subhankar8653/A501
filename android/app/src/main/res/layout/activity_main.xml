<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Pehla launch / reload ke waqt WebView blank/white dikhta tha jab tak
         onPageFinished nahi aata — ab tab tak yeh chhota branded loading
         state dikhta hai (SwipeRefresh ka spinner sirf manual pull-to-refresh
         par dikhta hai, isliye cold-start ke liye alag se yeh chahiye). -->
    <LinearLayout
        android:id="@+id/initialLoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0B0F"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/initialLoadingSpinner"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="#FFD700" />

        <TextView
            android:id="@+id/initialLoadingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.6"
            android:text="Huka Tube load ho raha hai…"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Network fail / server down waqt page blank ya browser ka default error
         dikhta tha, kabhi retry ka koi seedha rasta nahi tha — ab apna dark,
         branded error state hai jisme ek tap se webView.reload() ho jaata hai. -->
    <LinearLayout
        android:id="@+id/loadErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0B0F"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/loadErrorIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/loadErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No internet connection"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loadErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.6"
            android:gravity="center"
            android:text="Please check your connection and try again"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/loadErrorRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_retry_button"
            android:paddingLeft="28dp"
            android:paddingTop="10dp"
            android:paddingRight="28dp"
            android:paddingBottom="10dp"
            android:text="Retry"
            android:textAllCaps="false"
            android:textColor="#0B0B0F"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- BUG FIX ROUND 2 (user report: "kuchh bhi nahi badla, nav bar same hai")
         — pichli baar sirf styles.xml mein android:navigationBarColor set
         kiya tha, lekin yeh targetSdk 36 par kaam nahi karta: is SDK par
         Android edge-to-edge FORCE karta hai (MainActivity.kt mein
         WindowCompat.setDecorFitsSystemWindows(window, false) comment dekho)
         — is mode mein legacy navigationBarColor theme-attribute OS khud
         ignore kar deta hai, nav bar hamesha transparent hi rehta hai chahe
         theme mein kuch bhi ho. Asli fix: apna khud ka solid black View
         seedha yahan (activity_main.xml ke root ke SABSE AAKHIR mein, taaki
         WebView/loading/error — teeno — ke upar draw ho) rakho, bottom
         gravity ke saath, jiski height MainActivity.kt runtime par asli
         navigation-bar inset ke barabar set karta hai. Yeh transparent nav
         bar ke "peeche" wahi solid black dikhayega jo neeche dikhna chahiye
         — bilkul YouTube jaisa — page ka content/ambient color ab is
         opaque bar ke peeche chhup jaata hai. -->
    <View
        android:id="@+id/navBarMask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="#000000" />

</FrameLayout>
