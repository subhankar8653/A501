<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/inlinePlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:controller_layout_id="@layout/inline_player_control_view"
        app:show_buffering="when_playing"
        app:surface_type="texture_view" />

    <include layout="@layout/inline_top_bar" />

    <!-- Double-tap ±10s seek ka feedback — ab fullscreen ke speedIndicatorBadge
         jaisa hi ek chhota pill, video ke top border ke paas (center video
         ko block nahi karta, bilkul fullscreen wale small notification jaisa). -->
    <TextView
        android:id="@+id/inlineSeekFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="38dp"
        android:background="@drawable/speed_badge_bg"
        android:paddingHorizontal="9dp"
        android:paddingVertical="3dp"
        android:textColor="#0B0B12"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="⏩ 10s" />

    <!-- Hold-to-2x speed badge — fullscreen ke speedIndicatorBadge jaisa hi
         (chhota pill, video ke top border ke paas). -->
    <TextView
        android:id="@+id/inlineSpeedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="38dp"
        android:background="@drawable/speed_badge_bg"
        android:paddingHorizontal="9dp"
        android:paddingVertical="3dp"
        android:text="2x"
        android:textColor="#0B0B12"
        android:textStyle="bold"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Lock hone par yahi dikhta hai — baaki sab (top bar/bottom controls)
         chhup jaate hain, tap karke unlock ho jaata hai. -->
    <ImageView
        android:id="@+id/inlineUnlockButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:padding="6dp"
        android:src="@drawable/ic_lock"
        android:background="@drawable/bg_icon_circle"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:contentDescription="unlock" />

</FrameLayout>
