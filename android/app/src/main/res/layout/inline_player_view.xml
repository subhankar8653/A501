<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ambient Glow (same technique as the fullscreen player's AmbientGlowView):
         sits BEHIND PlayerView so it only shows through the video's own
         letterbox gutter (if the video's aspect ratio doesn't exactly fill
         this box) — never tints the actual video pixels.

         BUG FIX (user report: border-jaisa hard seam + title text aadha
         overlap ho raha tha): pehle is box ko video ke div se BAHAR (40dp
         upar-neeche) expand kiya tha taaki glow bleed ho sake — lekin us
         extra hisse mein native overlay web page ke apne (neeche wale)
         title text ke upar hi baith jaata tha (dono layers ek hi jagah
         draw kar rahe the), isliye text aadha dikhta, aadha overlay se
         dabta — aur glow ka edge ek sharp seam jaisa dikhta tha. Ab yeh
         box wapas EXACT video-div ke rect jitna hi hai — koi overlap
         nahi. "Video ke bahar bleed" wala effect ab web layer (Player.jsx)
         mein CSS se hota hai, jahan spacing/z-index precisely control ho
         sakta hai bina native ke saath overlap kiye. -->
    <com.suhani.videoplayer.AmbientGlowView
        android:id="@+id/inlineAmbientGlowView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/inlinePlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:controller_layout_id="@layout/inline_player_control_view"
        app:show_buffering="never"
        app:surface_type="texture_view" />

    <!-- inline_top_bar.xml ab yahan include nahi hota — woh ab
         inline_player_control_view.xml ke andar hi maujood hai (dekho us
         file ka "Redesign #3" comment), taaki Media3 usse baaki controls
         ke saath EXACT ek hi fade animation mein sync rakh sake. -->

    <!-- BUG FIX (user report: "seek/skip karne par pause aur buffering ka
         icon ek saath dikhta hai, bekar lagta hai"): Media3 ka apna default
         buffering spinner (`show_buffering`) center mein hamare custom
         play/pause hero button ke UPAR hi draw hota tha, koi coordination
         nahi thi — dono ek saath dikhte the. Ab woh band karke (show_buffering
         "never") ek apna themed indicator banaya hai — dark-glass circle +
         gold ring, play/pause button jaisi hi jagah par. Kotlin (MainActivity)
         inhi dono ko cross-fade karta hai: buffering shuru -> play/pause
         fade-out + yeh fade/scale-in; buffering khatam -> ulta. Ek waqt mein
         sirf ek hi cheez dikhti hai, YouTube/premium player jaisa clean feel. -->
    <FrameLayout
        android:id="@+id/inlineBufferingIndicator"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_buffering_chip"
        android:visibility="gone"
        android:alpha="0"
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:elevation="4dp"
        android:clickable="false"
        android:focusable="false">

        <ProgressBar
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFD700" />
    </FrameLayout>

    <!-- FEATURE (user ask: "jab koi video shuru karein tab 'Processing...'
         dikhna chahiye jab tak load na ho jaaye, phir acche se chalega"):
         sirf pehli baar ka load hi is text ko dikhata hai (Kotlin side:
         inlineIsInitialLoadForCurrentItem) — mid-playback rebuffering mein
         sirf upar wala spinner dikhta hai, yeh nahi.
         BUG FIX (user report: "processing jo likha hai wahan hona chahiye
         jahan pause/play button hota hai, prev/next ke beech mein"): pehle
         yahan 26dp ka marginTop tha (bufferingIndicator chip se overlap na
         ho isliye add kiya gaya tha), jo isse play button ki asli jagah se
         neeche shift kar deta tha. inlineBufferingIndicator (upar) EXACT
         isi FrameLayout ke plain `gravity="center"` se hi play/pause button
         ki jagah par sahi baithta hai (uske apne comment ke mutabik) — ab
         yeh bhi wahi plain center use karta hai, koi extra offset nahi, to
         dono exactly ek hi jagah (play button ki spot) par align hote hain. -->
    <TextView
        android:id="@+id/inlineProcessingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_processing_chip"
        android:text="Processing…"
        android:textColor="#FFF8E7"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="4dp"
        android:clickable="false"
        android:focusable="false" />

    <!-- BUG FIX (user report): pehle yeh ek single pill tha jismein text
         color #0B0B12 (near-black) tha, jo dark background ke upar
         practically invisible tha. Ab fullscreen player (activity_player.xml
         ke seekIndicatorLeft/Right) jaisa hi exact style — icon-in-circle +
         bold white "10s" text — bas thoda chhota (inline area ke hisaab se). -->
    <LinearLayout
        android:id="@+id/inlineSeekIndicatorLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/seek_chevron_bg">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_fast_rewind"
                android:contentDescription="rewind" />
        </FrameLayout>

        <TextView
            android:id="@+id/inlineSeekTextLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            tools:text="10s" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/inlineSeekIndicatorRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/inlineSeekTextRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            tools:text="10s" />

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/seek_chevron_bg">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_fast_forward"
                android:contentDescription="forward" />
        </FrameLayout>
    </LinearLayout>

    <!-- Hold-to-2x speed badge — fullscreen ke speedIndicatorBadge jaisa hi
         (chhota pill, video ke top border ke paas). BUG FIX: textColor ab
         white hai (#FFFFFF) — pehle #0B0B12 tha jo pill ke dark background
         ke upar dikhta hi nahi tha. -->
    <TextView
        android:id="@+id/inlineSpeedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/speed_badge_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="2x"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Lock feature hata di gayi hai (user ne kaha ki iska icon "ajeeb"
         lagta tha) — inlineUnlockButton yahan pehle tha. -->

</FrameLayout>
