<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/inlinePlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:controller_layout_id="@layout/inline_player_control_view"
        app:show_buffering="when_playing"
        app:surface_type="texture_view" />

    <include layout="@layout/inline_top_bar" />

    <!-- Lock hone par yahi dikhta hai — baaki sab (top bar/bottom controls)
         chhup jaate hain, tap karke unlock ho jaata hai. -->
    <ImageView
        android:id="@+id/inlineUnlockButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:padding="6dp"
        android:src="@drawable/ic_lock"
        android:background="@drawable/bg_icon_circle"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:contentDescription="unlock" />

</FrameLayout>
