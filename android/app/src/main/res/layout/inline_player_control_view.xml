<?xml version="1.0" encoding="utf-8"?>
<!--
    YouTube reference jaisa clean bottom area:
      - beech mein plain (bina circle-chip ke) prev/play-pause/next, bade aur
        khule spaced — reference screenshot ke exact jaisa
      - sabse neeche: time text (left) + quality + fullscreen-expand (right)
        ek line mein, aur uske bilkul niche edge-to-edge patli progress line
        (bina padding/pill)
      - Bug fix ("ajeeb"/cluttered lagta tha): quality/fullscreen ab plain
        icon+text hain — chip-background (bg_icon_circle) hata diya, sirf
        bottom gradient se contrast milta hai, YouTube jaisa flat look
      - Lock button poori tarah hata diya gaya hai (user ne khud maanga —
        iski wajah se UI "ajeeb" lagti thi)
      - Pip/Aspect ab yahan clutter nahi karte — settings (gear) menu mein chale
        gaye hain (reference mein bhi yeh seedhe visible nahi hote)
    exo_progress/exo_position/exo_duration ke ids wahi purane hain (Media3 khud
    bind kar leta hai). Play/pause/prev/next ab custom ids hain — MainActivity.kt
    inhe manually wire karta hai (wajah upar comment mein hai).

    Premium pass (user ne poora player aur premium maanga — reference:
    custom_player_control_view.xml, jahan yeh treatment pehle se hai):
      - Center play/pause ab plain icon nahi — wahi gold radial-glow "hero"
        squircle (bg_play_button_hero) jo fullscreen player mein hai. Ye
        clutter nahi hai kyunki sirf EK hero button hai, prev/next abhi bhi
        plain hain (user ne unke chip-background waala clutter khud hataya tha).
      - Progress bar ka accent color generic YouTube-red se badal ke app ka
        apna gold brand color (#FFD700) kar diya — baaki poore app
        (fullscreen player, web player) mein yehi gold hai, ab yahan bhi
        consistent hai. Plain white dot ki jagah gold glow scrubber handle
        (scrubber_handle_premium) — wahi jo fullscreen player use karta hai.
      - Prev/next aur fullscreen icons ab warm off-white tint (#FFF8E7) +
        bahut halka soft-glow backdrop (bg_icon_soft_glow) lete hain — same
        halka treatment jo top bar mein diya, boxy chip jaisa nahi.
      - Quality text ("Auto"/"1080p") ka color plain white se badal ke gold
        kiya — time text se alag/highlighted dikhta hai, extra background
        chip ke bina hi thoda "premium tag" jaisa feel deta hai.

    Redesign #2 (user report: "play/pause button bada aur aankhon mein
    chubh raha hai" — the bright gold radial-glow squircle borrowed from
    the fullscreen player): replaced with bg_inline_hero_button — a
    smaller (46dp, was 54dp) plain dark-glass circle + thin gold hairline
    ring, no bright fill/glow. Icon itself is now gold-tinted (was dark ink
    on bright gold) so the accent still reads as premium/gold, just calm.

    Redesign #3 (user report: "controls chhupte/aate waqt runtime bar aur
    baaki icons ek saath nahi hote, thoda pehle-baad mein gayab hote hain,
    isper achha premium transition animation chahiye"): root cause was that
    inline_top_bar.xml lived OUTSIDE this controller layout (a sibling
    <include> in inline_player_view.xml), so MainActivity.kt had to
    manually sync its visibility via setControllerVisibilityListener — but
    that was an INSTANT visibility flip, while Media3 fades THIS layout's
    own visibility in/out with its own built-in animation. Two different
    animation systems on two different views = visible stagger, exactly
    what was reported. Fix: the top bar row is now moved IN HERE, as the
    first child of this same root — so it's physically part of the exact
    same view Media3 already fades as a single unit. Same animation, same
    timing, zero custom sync code needed (setControllerVisibilityListener
    calls were removed from MainActivity.kt as part of this fix).
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar (moved in from the old inline_top_bar.xml — see "Redesign #3"
         comment above for why: being inside this same root means Media3
         fades it together with everything else, with zero custom sync
         code). Same content/ids as before, just relocated. -->
    <LinearLayout
        android:id="@+id/inlineTopBarRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_top_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <!-- Chevron-down: shrinks the inline player into PiP, matching the
                 fullscreen player's dedicated icon. -->
            <ImageView
                android:id="@+id/inlinePipChevron"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_down_pip"
                android:tint="#FFF8E7"
                android:background="@drawable/bg_icon_soft_glow"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="minimize to mini player" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/inlineAudioTrackButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_audiotrack"
                android:tint="#FFF8E7"
                android:background="@drawable/bg_icon_soft_glow"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="audio track" />

            <ImageView
                android:id="@+id/inlineSubtitleButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_subtitle"
                android:tint="#FFF8E7"
                android:background="@drawable/bg_icon_soft_glow"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="subtitle" />

            <ImageView
                android:id="@+id/inlineSettingsButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_settings"
                android:tint="#FFF8E7"
                android:background="@drawable/bg_icon_soft_glow"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="settings" />

            <!-- Hidden — settings-sheet ke "Playback speed"/"Decoder" row se
                 performClick() hote hain, logic wahi purana hai -->
            <TextView
                android:id="@+id/inlineSpeedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="1.0x" />

            <TextView
                android:id="@+id/inlineDecoderButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="HW+"
                android:contentDescription="decoder select" />

        </LinearLayout>

    </LinearLayout>

    <!-- Center row: plain icons, no background chip, evenly spread — reference jaisa.
         Bug fix: play/pause pehle DO alag overlapping ImageButtons the (exo_play +
         exo_pause) jinki visibility Media3 khud toggle karta tha — kisi wajah se
         dono ek saath dikh rahe the. Ab sirf EK button hai jiska icon Kotlin khud
         state ke hisaab se badalta hai, isliye overlap structurally possible hi
         nahi. Prev/Next bhi custom ids hain — Media3 ka apna "queue" wala auto
         enable/disable kaam nahi karta tha kyunki chhote player mein asli playlist
         load hi nahi hoti; ab yeh seedhe real "agla/pichla episode hai ya nahi"
         data se chalte hain (Kotlin se wire hota hai). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="28dp">

        <ImageButton
            android:id="@+id/inlinePrevButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="4dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="#FFF8E7"
            android:background="@drawable/bg_icon_soft_glow"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="previous episode" />

        <ImageButton
            android:id="@+id/inlinePlayPauseButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="36dp"
            android:padding="12dp"
            android:elevation="2dp"
            android:src="@drawable/ic_pause"
            android:tint="#FFD700"
            android:background="@drawable/bg_inline_hero_button"
            android:contentDescription="play or pause" />

        <ImageButton
            android:id="@+id/inlineNextButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="4dp"
            android:src="@drawable/ic_skip_next"
            android:tint="#FFF8E7"
            android:background="@drawable/bg_icon_soft_glow"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="next episode" />

    </LinearLayout>

    <!-- Bottom strip: time text + expand icon, then a flush full-width
         progress line right at the very edge. Lock button hata diya gaya hai
         (YouTube reference jaisa clean look ke liye user ne khud maanga).

         BUG FIX (user report + screenshots: "jo time bar hai woh YouTube mein
         video ke ekdam edge/niche laga hota hai, mera thoda andar se shuru
         hota hai"): neeche wala DefaultTimeBar pehle info-row (time/quality/
         fullscreen) ke saath EK hi LinearLayout ke andar tha, jispar
         marginStart=10dp/marginEnd=6dp tha — woh margin sirf info-row ke
         text/icons ke liye chahiye tha (taaki edge se na chipke), lekin
         LinearLayout ka child hone ki wajah se DefaultTimeBar ko bhi wahi
         side-margin mil jaata tha, isliye woh bhi thoda andar se shuru/khatam
         hota tha — YouTube ki tarah screen ke bilkul left-right edge tak
         nahi jaata tha.

         BUG FIX ROUND 2 (user report: "2-3 video play kiya to time bar
         hang/upar chala gaya"; "auto-hide hote waqt time bar sabse pehle
         hide hota hai, phir baaki icons — sab ek saath hide hona chahiye"):
         pehli try mein DefaultTimeBar ko is LinearLayout se nikaal kar ek
         ALAG FrameLayout child (layout_gravity="bottom", apna khud ka
         absolute-positioned overlay) bana diya tha — usi se yeh dono naye
         bug aaye. Fix: DefaultTimeBar wapas EK hi (single, flat)
         LinearLayout ke andar rakho — bas ab apni khud ki, poori width wali,
         zero-margin row ke taur par (info-row wale margined inner-LinearLayout
         se BAHAR, lekin dono ab bhi isi ek hi seedhe vertical stack ke
         children hain, alag FrameLayout/gravity mechanism nahi) — isse edge-
         to-edge bhi milta hai AUR yeh us single, ek-saath-fade-hone-wale
         controller hierarchy ka hi hissa rehta hai (jaisa upar wala "top
         bar" comment describe karta hai), koi alag absolute-position layer
         nahi banti jo galat height-measurement/hang ka risk banaye. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Current quality (jaise "1080p") — tap karke list se badal sakte hain.
                 Bug fix: chip-background hataya, ab plain bold text hai — time text
                 jaisa hi treatment, YouTube reference mein bhi koi box/chip nahi hota. -->
            <TextView
                android:id="@+id/inlineQualityButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:padding="4dp"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:text="Auto"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <ImageView
                android:id="@+id/inlineFullscreenButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:src="@drawable/ic_fullscreen_expand"
                android:tint="#FFF8E7"
                android:background="@drawable/bg_icon_soft_glow"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="fullscreen" />

        </LinearLayout>

        <!-- Flush, edge-to-edge, zero margin — bilkul YouTube reference ki
             thin line jaisa. Info-row ka sibling hai (isi ek LinearLayout ke
             andar), FrameLayout/gravity wala alag overlay nahi. -->
        <!-- FIX (build error: setScrubberDrawable unresolved) — app:scrubber_drawable
             removed. This project's self-built media3-ui.aar doesn't expose a
             public setScrubberDrawable() setter (confirmed by inspecting the
             aar's compiled classes), so a custom drawable set here could never
             be re-tinted at runtime to match the theme color anyway. Dropping
             it falls back to DefaultTimeBar's BUILT-IN scrubber dot, which DOES
             respond to setScrubberColor() (both the XML value below and
             MainActivity.kt's applyInlineThemeColor()). -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            app:played_color="#FFD700"
            app:scrubber_color="#FFD700"
            app:unplayed_color="#4DFFFFFF"
            app:buffered_color="#80FFFFFF"
            app:bar_height="2.5dp"
            app:touch_target_height="14dp"
            app:scrubber_enabled_size="12dp"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="18dp" />

        <!-- Hidden — settings-gear menu se performClick() hote hain, logic wahi purana -->
        <ImageView
            android:id="@+id/inlinePipButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:src="@drawable/ic_pip"
            android:contentDescription="picture in picture" />

        <ImageView
            android:id="@+id/inlineAspectButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:src="@drawable/ic_aspect_ratio"
            android:contentDescription="resize" />

    </LinearLayout>

</LinearLayout>
