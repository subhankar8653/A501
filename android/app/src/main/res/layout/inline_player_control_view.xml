<?xml version="1.0" encoding="utf-8"?>
<!--
    Chhote (inline) player ka bottom control bar — fullscreen wale
    custom_player_control_view.xml jaisा hi look/buttons (lock, prev,
    play/pause, next, pip, resize, fullscreen), bas sab kuch chhota (is
    small area ke hisaab se). exo_play/exo_pause/exo_prev/exo_next/
    exo_progress/exo_position/exo_duration ke ids fullscreen jaise hi
    rakhe hain isliye media3 khud automatically bind kar leta hai — extra
    wiring nahi chahiye. (exo_prev/exo_next abhi grayed/disabled dikhenge
    jab tak single video mount hai — queue milte hi khud enable ho jaayenge.)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_gradient"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <!-- Seekbar row: position | timebar | duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:minWidth="20dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                app:played_color="#FFD700"
                app:scrubber_color="#FFD700"
                app:unplayed_color="#4DFFFFFF"
                app:buffered_color="#80FFFFFF"
                app:scrubber_drawable="@drawable/scrubber_handle_premium"
                app:scrubber_enabled_size="8dp"
                app:scrubber_disabled_size="4dp"
                app:scrubber_dragged_size="10dp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:minWidth="20dp"
                android:gravity="end"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />
        </LinearLayout>

        <!-- Single bottom row: Lock, Play/Pause, PIP, Resize, Fullscreen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="2dp"
            android:paddingTop="2dp">

            <ImageView
                android:id="@+id/inlineLockButton"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="4dp"
                android:src="@drawable/ic_lock"
                android:background="@drawable/bg_icon_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="lock" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@id/exo_prev"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/ic_skip_previous"
                android:background="@drawable/bg_icon_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="previous" />

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="2dp">

                <ImageButton
                    android:id="@id/exo_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:elevation="3dp"
                    android:src="@drawable/ic_play_arrow"
                    android:background="@drawable/bg_play_button_hero"
                    android:contentDescription="play" />

                <ImageButton
                    android:id="@id/exo_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:elevation="3dp"
                    android:src="@drawable/ic_pause"
                    android:background="@drawable/bg_play_button_hero"
                    android:contentDescription="pause" />
            </FrameLayout>

            <ImageButton
                android:id="@id/exo_next"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/ic_skip_next"
                android:background="@drawable/bg_icon_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="next" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/inlinePipButton"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:padding="3dp"
                android:src="@drawable/ic_pip"
                android:background="@drawable/bg_icon_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="picture in picture" />

            <ImageView
                android:id="@+id/inlineAspectButton"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="2dp"
                android:padding="3dp"
                android:src="@drawable/ic_aspect_ratio"
                android:background="@drawable/bg_icon_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="resize" />

            <ImageView
                android:id="@+id/inlineFullscreenButton"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="2dp"
                android:padding="3dp"
                android:src="@drawable/ic_fullscreen_expand"
                android:background="@drawable/bg_icon_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="fullscreen" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
