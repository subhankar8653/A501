<?xml version="1.0" encoding="utf-8"?>
<!--
    YouTube reference jaisa clean bottom area:
      - beech mein plain (bina circle-chip ke) prev/play-pause/next, bade aur
        khule spaced — reference screenshot ke exact jaisa
      - sabse neeche: time text (left) + quality + fullscreen-expand (right)
        ek line mein, aur uske bilkul niche edge-to-edge patli progress line
        (bina padding/pill)
      - Bug fix ("ajeeb"/cluttered lagta tha): quality/fullscreen ab plain
        icon+text hain — chip-background (bg_icon_circle) hata diya, sirf
        bottom gradient se contrast milta hai, YouTube jaisa flat look
      - Lock button poori tarah hata diya gaya hai (user ne khud maanga —
        iski wajah se UI "ajeeb" lagti thi)
      - Pip/Aspect ab yahan clutter nahi karte — settings (gear) menu mein chale
        gaye hain (reference mein bhi yeh seedhe visible nahi hote)
    exo_progress/exo_position/exo_duration ke ids wahi purane hain (Media3 khud
    bind kar leta hai). Play/pause/prev/next ab custom ids hain — MainActivity.kt
    inhe manually wire karta hai (wajah upar comment mein hai).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Bug fix: pehle center row poore box (top-bar ke peeche wale hisse
         samet) ke hisaab se center hoti thi, isliye visually upar-upar dikhti
         thi (top bar chhota box mein bada hissa le leta hai). Yeh spacer
         inline_top_bar.xml ki approx height jitna hai — ab center row sirf
         top-bar ke NEECHE wale asli-dikhne-wale hisse mein center hoti hai.
         BUG FIX (user report: "time bar/controls thoda upar chala gaya hai"):
         yeh spacer pehle 36dp tha, lekin inline_top_bar.xml ki asli height
         46dp hai (marginTop 6dp + paddingVertical 4dp+4dp + icon 32dp) — 10dp
         ka mismatch, isliye poora center control row usi 10dp jitna upar
         khinch jaata tha. Ab exact match kar diya. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <!-- Center row: plain icons, no background chip, evenly spread — reference jaisa.
         Bug fix: play/pause pehle DO alag overlapping ImageButtons the (exo_play +
         exo_pause) jinki visibility Media3 khud toggle karta tha — kisi wajah se
         dono ek saath dikh rahe the. Ab sirf EK button hai jiska icon Kotlin khud
         state ke hisaab se badalta hai, isliye overlap structurally possible hi
         nahi. Prev/Next bhi custom ids hain — Media3 ka apna "queue" wala auto
         enable/disable kaam nahi karta tha kyunki chhote player mein asli playlist
         load hi nahi hoti; ab yeh seedhe real "agla/pichla episode hai ya nahi"
         data se chalte hain (Kotlin se wire hota hai). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="28dp">

        <ImageButton
            android:id="@+id/inlinePrevButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="4dp"
            android:src="@drawable/ic_skip_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="previous episode" />

        <ImageButton
            android:id="@+id/inlinePlayPauseButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="36dp"
            android:padding="4dp"
            android:elevation="4dp"
            android:src="@drawable/ic_pause"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="play or pause" />

        <ImageButton
            android:id="@+id/inlineNextButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="4dp"
            android:src="@drawable/ic_skip_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="next episode" />

    </LinearLayout>

    <!-- Bottom strip: time text + expand icon, then a flush full-width
         progress line right at the very edge. Lock button hata diya gaya hai
         (YouTube reference jaisa clean look ke liye user ne khud maanga). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@id/exo_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@id/exo_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Current quality (jaise "1080p") — tap karke list se badal sakte hain.
                     Bug fix: chip-background hataya, ab plain bold text hai — time text
                     jaisa hi treatment, YouTube reference mein bhi koi box/chip nahi hota. -->
                <TextView
                    android:id="@+id/inlineQualityButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:padding="4dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:text="Auto"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4" />

                <ImageView
                    android:id="@+id/inlineFullscreenButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_fullscreen_expand"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="fullscreen" />

            </LinearLayout>

            <!-- Flush, edge-to-edge, no pill/padding — reference ki thin red line jaisa -->
            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                app:played_color="#FF3B30"
                app:scrubber_color="#FF3B30"
                app:unplayed_color="#4DFFFFFF"
                app:buffered_color="#80FFFFFF"
                app:bar_height="2dp"
                app:touch_target_height="10dp"
                app:scrubber_enabled_size="9dp"
                app:scrubber_disabled_size="0dp"
                app:scrubber_dragged_size="11dp" />

        </LinearLayout>

        <!-- Hidden — settings-gear menu se performClick() hote hain, logic wahi purana -->
        <ImageView
            android:id="@+id/inlinePipButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:src="@drawable/ic_pip"
            android:contentDescription="picture in picture" />

        <ImageView
            android:id="@+id/inlineAspectButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:src="@drawable/ic_aspect_ratio"
            android:contentDescription="resize" />

    </FrameLayout>

</LinearLayout>
