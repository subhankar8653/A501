<?xml version="1.0" encoding="utf-8"?>
<!--
    User ne back-arrow aur title text dono hatane ko kaha — page ka apna back
    navigation already hai, isliye yeh redundant tha. Audio track ab seedha
    visible hai (CC ke bagal mein), settings gear se ab neeche wala naya
    bottom-sheet khulta hai (dekho inline_settings_sheet.xml).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inlineTopBarRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:orientation="vertical"
    android:background="@drawable/bg_top_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="2dp"
        android:paddingVertical="2dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/inlineAudioTrackButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="5dp"
            android:src="@drawable/ic_audiotrack"
            android:background="@drawable/bg_icon_circle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="audio track" />

        <ImageView
            android:id="@+id/inlineSubtitleButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:padding="5dp"
            android:src="@drawable/ic_subtitle"
            android:background="@drawable/bg_icon_circle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="subtitle" />

        <ImageView
            android:id="@+id/inlineSettingsButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:padding="5dp"
            android:src="@drawable/ic_settings"
            android:background="@drawable/bg_icon_circle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="settings" />

        <!-- Hidden — settings-sheet ke "Playback speed"/"Decoder" row se
             performClick() hote hain, logic wahi purana hai -->
        <TextView
            android:id="@+id/inlineSpeedButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="1.0x" />

        <TextView
            android:id="@+id/inlineDecoderButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="HW+"
            android:contentDescription="decoder select" />

    </LinearLayout>

</LinearLayout>
