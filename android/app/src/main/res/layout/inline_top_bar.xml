<?xml version="1.0" encoding="utf-8"?>
<!--
    Chhote (inline) player ka top bar — ab YouTube jaisa clean: sirf back,
    title, ek settings (gear) icon aur more. Audio track / subtitle / speed /
    decoder ab alag-alag icons ki jagah isi gear ke peeche ek chhota menu mein
    hain (functionality bilkul wahi hai — bas dikhta saaf hai). Purane buttons
    ko hataya nahi gaya (Kotlin unke ids/click-logic use karta hai), sirf
    visibility="gone" kar diya hai; settings-menu unhi par performClick()
    karta hai taaki koi logic dobara likhni na pade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inlineTopBarRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:orientation="vertical"
    android:background="@drawable/bg_top_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="2dp"
        android:paddingVertical="2dp">

        <ImageView
            android:id="@+id/inlineBackButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="5dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_icon_circle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="back" />

        <TextView
            android:id="@+id/inlineTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <!-- YouTube-style: ek hi gear icon ke peeche audio/subtitle/speed/decoder -->
        <ImageView
            android:id="@+id/inlineSettingsButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:padding="5dp"
            android:src="@drawable/ic_settings"
            android:background="@drawable/bg_icon_circle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="settings" />

        <ImageView
            android:id="@+id/inlineMoreButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:padding="5dp"
            android:src="@drawable/ic_more_vert"
            android:background="@drawable/bg_icon_circle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="more" />

        <!-- Hidden — ab settings-menu ke peeche, lekin id/click-logic wahi purana hai -->
        <ImageView
            android:id="@+id/inlineAudioTrackButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:src="@drawable/ic_audiotrack"
            android:contentDescription="audio track" />

        <ImageView
            android:id="@+id/inlineSubtitleButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:src="@drawable/ic_subtitle"
            android:contentDescription="subtitle" />

        <TextView
            android:id="@+id/inlineSpeedButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="1.0x" />

        <TextView
            android:id="@+id/inlineDecoderButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="HW+"
            android:contentDescription="decoder select" />

    </LinearLayout>

</LinearLayout>
