<?xml version="1.0" encoding="utf-8"?>
<!--
    User ne back-arrow aur title text dono hatane ko kaha — page ka apna back
    navigation already hai, isliye yeh redundant tha. Audio track ab seedha
    visible hai (CC ke bagal mein), settings gear se ab neeche wala naya
    bottom-sheet khulta hai (dekho inline_settings_sheet.xml).

    Bug fix (YouTube ke saamne "ajeeb"/cluttered lagta tha): har icon ke peeche
    ek chhota gradient+border "chip" (bg_icon_circle) tha — YouTube ka player
    icons plain rakhta hai, sirf top gradient (bg_top_gradient) se contrast
    milta hai. Ab chip backgrounds hata diye — sirf icon + borderless ripple,
    thoda bada size — clean/flat look.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inlineTopBarRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:orientation="vertical"
    android:background="@drawable/bg_top_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp">

        <!-- Chevron-down: shrinks the inline player into PiP, matching the
             fullscreen player's dedicated icon. User specifically asked for
             this to be visible here (it wasn't before — the pip button
             existed but was hidden, settings-menu-only). -->
        <ImageView
            android:id="@+id/inlinePipChevron"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_down_pip"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="minimize to mini player" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/inlineAudioTrackButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_audiotrack"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="audio track" />

        <ImageView
            android:id="@+id/inlineSubtitleButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_subtitle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="subtitle" />

        <ImageView
            android:id="@+id/inlineSettingsButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_settings"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="settings" />

        <!-- Hidden — settings-sheet ke "Playback speed"/"Decoder" row se
             performClick() hote hain, logic wahi purana hai -->
        <TextView
            android:id="@+id/inlineSpeedButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="1.0x" />

        <TextView
            android:id="@+id/inlineDecoderButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="HW+"
            android:contentDescription="decoder select" />

    </LinearLayout>

</LinearLayout>
