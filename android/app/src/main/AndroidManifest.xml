<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Sisisisi player ke liye: offline/local video files play karne ke liye -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Cast (Chromecast) device discovery ke liye -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Equalizer / Bass Boost / Virtualizer ke liye -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Background Play (screen off ke baad bhi audio chalu) ke liye foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- BUG FIX (user report: "app background jaate hi download cancel ho
         jaata hai, notification bar mein progress nahi dikhta"): downloads ab
         DownloadService (foreground service) ke andar chalte hain — dekho
         DownloadService.kt. Android 14+ (API 34) par har foreground service
         ko apna type declare karna zaroori hai; download/file-transfer ke
         liye "dataSync" sahi type hai, aur usse match karti permission bhi. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:label="Huka Tube"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.SuhaniScreen"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <!-- Cast SDK yahan se apni options leta hai (PlayerActivity ke andar cast button ke liye) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.suhani.videoplayer.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sisisisi ka full-featured native video player - web frontend (VideoPlayer.jsx)
             ab isi Activity ko JS bridge ke through launch karta hai, HTML5 <video> tag ke
             bajaye. Online (http/hls) aur offline (local file) dono URI accept karta hai. -->
        <activity
            android:name="com.suhani.videoplayer.PlayerActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <service
            android:name="com.suhani.videoplayer.BackgroundPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- BUG FIX (user report: "download background mein cancel ho jaata
             hai, notification bar mein progress nahi dikhta") — dekho
             DownloadService.kt ka doc comment. -->
        <service
            android:name="com.suhani.screen.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Offline download files (NativeDownloadManager) ko content:// URI ke
             through window.AndroidPlayer tak pahunchane ke liye — isi se offline
             playback bhi online jaisa hi poora-feature native player use karta hai. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.downloads.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/downloads_file_paths" />
        </provider>

    </application>
</manifest>
