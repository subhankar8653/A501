diff -ruN -x node_modules -x __pycache__ orig/A501-main/deploy/vps-setup.sh a501src/A501-main/deploy/vps-setup.sh
--- orig/A501-main/deploy/vps-setup.sh	1970-01-01 00:00:00.000000000 +0000
+++ a501src/A501-main/deploy/vps-setup.sh	2026-11-04 08:21:08.527844780 +0000
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# One-time VPS prep (Ubuntu/Debian). Run as root:  bash vps-setup.sh
+# Installs Docker and closes every inbound port except SSH. The backend needs
+# NO inbound port at all (Cloudflare Tunnel connects outwards).
+set -euo pipefail
+
+if ! command -v docker >/dev/null 2>&1; then
+  curl -fsSL https://get.docker.com | sh
+fi
+
+apt-get update -y
+apt-get install -y ufw rsync
+
+SSH_PORT="${SSH_PORT:-22}"
+ufw default deny incoming
+ufw default allow outgoing
+ufw allow "${SSH_PORT}/tcp"
+ufw --force enable
+
+systemctl enable --now docker
+echo "Done. Docker installed, firewall: only SSH (${SSH_PORT}) open."
