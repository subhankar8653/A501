--- orig/A501-main/frontend/src/lib/endpoints.js	1970-01-01 00:00:00.000000000 +0000
+++ a501src/A501-main/frontend/src/lib/endpoints.js	2026-11-04 08:17:11.538663587 +0000
@@ -0,0 +1,127 @@
+// Backend address book + automatic failover.
+//
+// Why this exists: the app must never be tied to one server. It talks to a
+// DOMAIN (put behind Cloudflare Tunnel), never to an IP / railway.app /
+// VPS hostname. When you move the backend to a new VPS, you just point the
+// same domain/tunnel at it and nothing in the app changes. If you ever need
+// a NEW domain, add it from the Telegram bot (/endpoints add https://...);
+// every app learns it on its next update-check, and this file silently
+// switches over when the current domain stops answering.
+//
+// Build-time (GitHub secret -> env):
+//   VITE_BACKEND_URL        primary domain, e.g. https://api.example.com
+//   VITE_BACKEND_FALLBACKS  optional, comma separated extra domains
+// Runtime: extra domains pushed by the bot are stored in localStorage.
+
+const CONFIG_KEY = 'suhani-screen:config' // same key api.js uses
+const REMOTE_KEY = 'huka:endpoints'
+const ACTIVE_KEY = 'huka:active-endpoint'
+
+const clean = (u) => String(u || '').trim().replace(/\/+$/, '')
+const isHttps = (u) => /^https:\/\/[a-z0-9.-]+(:\d+)?$/i.test(u)
+
+const BUILD_PRIMARY = clean(import.meta.env.VITE_BACKEND_URL || '')
+const BUILD_FALLBACKS = String(import.meta.env.VITE_BACKEND_FALLBACKS || '')
+  .split(',')
+  .map(clean)
+  .filter(Boolean)
+
+function readJson(key) {
+  try {
+    const raw = localStorage.getItem(key)
+    return raw ? JSON.parse(raw) : null
+  } catch {
+    return null
+  }
+}
+
+function writeJson(key, value) {
+  try {
+    localStorage.setItem(key, JSON.stringify(value))
+  } catch {
+    /* storage unavailable — failover still works for this session */
+  }
+}
+
+export function getEndpoints() {
+  const remote = readJson(REMOTE_KEY)
+  const all = [BUILD_PRIMARY, ...BUILD_FALLBACKS, ...(Array.isArray(remote) ? remote : [])]
+  return [...new Set(all.map(clean).filter(isHttps))]
+}
+
+// Called with the list the server sent along with an update-check.
+export function setRemoteEndpoints(list) {
+  if (!Array.isArray(list)) return
+  writeJson(REMOTE_KEY, list.map(clean).filter(isHttps))
+}
+
+export function activeBackend() {
+  const eps = getEndpoints()
+  const active = clean(readJson(ACTIVE_KEY))
+  if (active && eps.includes(active)) return active
+  const cfg = readJson(CONFIG_KEY)
+  const saved = clean(cfg && cfg.backendUrl)
+  if (saved && eps.includes(saved)) return saved
+  return eps[0] || ''
+}
+
+function setActive(url) {
+  writeJson(ACTIVE_KEY, url)
+  const cfg = readJson(CONFIG_KEY)
+  if (cfg && cfg.token) writeJson(CONFIG_KEY, { ...cfg, backendUrl: url })
+}
+
+// Old installs saved whatever backend URL they signed up against (e.g. the
+// previous railway.app address). If that address is not in this build's
+// list any more, move the saved login onto the current domain. The token
+// itself keeps working because it lives in the database, not on the server.
+export function rebaseStoredConfig() {
+  const cfg = readJson(CONFIG_KEY)
+  if (!cfg || !cfg.token) return
+  const eps = getEndpoints()
+  if (!eps.length) return
+  if (!eps.includes(clean(cfg.backendUrl))) {
+    writeJson(CONFIG_KEY, { ...cfg, backendUrl: activeBackend() })
+  }
+}
+
+// Cloudflare answers 52x/530 when the tunnel/origin behind a domain is down.
+const isOriginDown = (status) => status >= 520 && status <= 530
+
+export function installFetchFailover() {
+  if (window.__hukaFailoverInstalled) return
+  window.__hukaFailoverInstalled = true
+  const origFetch = window.fetch.bind(window)
+
+  window.fetch = async (input, init) => {
+    const url = typeof input === 'string' ? input : null
+    const eps = getEndpoints()
+    const cur = url ? eps.find((e) => url.startsWith(e + '/')) : null
+    if (!cur || eps.length < 2) return origFetch(input, init)
+
+    let firstError = null
+    let firstResponse = null
+    try {
+      const res = await origFetch(input, init)
+      if (!isOriginDown(res.status)) return res
+      firstResponse = res
+    } catch (err) {
+      if (err && err.name === 'AbortError') throw err
+      firstError = err
+    }
+
+    for (const alt of eps) {
+      if (alt === cur) continue
+      try {
+        const res = await origFetch(alt + url.slice(cur.length), init)
+        if (isOriginDown(res.status)) continue
+        setActive(alt)
+        return res
+      } catch (err) {
+        if (err && err.name === 'AbortError') throw err
+      }
+    }
+    if (firstResponse) return firstResponse
+    throw firstError
+  }
+}
diff -ruN -x node_modules -x __pycache__ orig/A501-main/frontend/src/lib/updateStore.js a501src/A501-main/frontend/src/lib/updateStore.js
--- orig/A501-main/frontend/src/lib/updateStore.js	1970-01-01 00:00:00.000000000 +0000
+++ a501src/A501-main/frontend/src/lib/updateStore.js	2026-11-04 08:17:57.031833397 +0000
@@ -0,0 +1,207 @@
+// In-app update logic (pure module — the React hook lives in useUpdate.js).
+//
+// Two kinds of updates, both pushed from the owner's Telegram bot:
+//   * bundle (OTA)  – a new UI (index.html). Downloaded silently in the
+//                     background by the native shell, applied on next start
+//                     or when the user taps "Restart now".
+//   * apk           – a new native build. User taps "Update now", the APK is
+//                     downloaded by the native shell and Android's installer
+//                     opens.
+//
+// Native contract (see android .../AppUpdater.kt, JS name "AndroidUpdater"):
+//   getAppInfo() -> JSON {versionCode, versionName, bundleVersion}
+//   downloadBundle(url, sha256, version) / downloadApk(url, sha256, code)
+//   applyBundle()     reload the WebView with the downloaded bundle
+//   markBootOk()      tell native this UI booted fine (auto-rollback guard)
+// and native calls back: window.__nativeUpdate(kind, state, pct, message)
+//   kind: 'apk' | 'bundle'
+//   state: 'progress' | 'ready' | 'installing' | 'needs_permission' | 'error'
+
+import { activeBackend, setRemoteEndpoints } from './endpoints'
+
+const EVENT = 'huka-update-changed'
+const DISMISSED_KEY = 'huka:update-dismissed' // version the user said "later" to
+const SEEN_KEY = 'huka:update-seen' // version whose notification card was opened
+const CHECK_EVERY_MS = 6 * 60 * 60 * 1000
+const MIN_GAP_MS = 20 * 60 * 1000
+
+let state = {
+  apk: null, // {version_code, version_name, changelog, force, url, sha256, size}
+  bundle: null, // {version, changelog, force, url, sha256, size}
+  apkStatus: 'idle', // idle | downloading | installing | needs_permission | error
+  apkPct: 0,
+  bundleStatus: 'idle', // idle | downloading | ready | error
+  lastCheck: 0,
+}
+
+export function getUpdateState() {
+  return state
+}
+
+function set(patch) {
+  state = { ...state, ...patch }
+  window.dispatchEvent(new CustomEvent(EVENT))
+}
+
+export const UPDATE_EVENT = EVENT
+
+function native() {
+  const u = window.AndroidUpdater
+  return u && typeof u.getAppInfo === 'function' ? u : null
+}
+
+export function hasNativeUpdater() {
+  return !!native()
+}
+
+function appInfo() {
+  try {
+    const n = native()
+    return n ? JSON.parse(n.getAppInfo()) : null
+  } catch {
+    return null
+  }
+}
+
+const absolute = (rel) => (/^https?:\/\//i.test(rel) ? rel : `${activeBackend()}${rel}`)
+
+function lsGet(k) {
+  try {
+    return localStorage.getItem(k)
+  } catch {
+    return null
+  }
+}
+function lsSet(k, v) {
+  try {
+    localStorage.setItem(k, v)
+  } catch {
+    /* ignore */
+  }
+}
+
+// ---------------------------------------------------------------- native -> JS
+window.__nativeUpdate = (kind, status, pct, message) => {
+  if (kind === 'bundle') {
+    if (status === 'ready') {
+      set({ bundleStatus: 'ready' })
+      // A "force" UI update applies itself right away.
+      if (state.bundle && state.bundle.force) applyBundle()
+    } else if (status === 'progress') set({ bundleStatus: 'downloading' })
+    else if (status === 'error') set({ bundleStatus: 'error' })
+  } else if (kind === 'apk') {
+    if (status === 'progress') set({ apkStatus: 'downloading', apkPct: Math.max(0, Math.min(100, pct | 0)) })
+    else if (status === 'installing') set({ apkStatus: 'installing', apkPct: 100 })
+    else if (status === 'needs_permission') set({ apkStatus: 'needs_permission' })
+    else if (status === 'error') set({ apkStatus: 'error' })
+  }
+  void message
+}
+
+// ---------------------------------------------------------------- actions
+export async function checkForUpdate(force = false) {
+  const n = native()
+  const info = appInfo()
+  if (!n || !info) return
+  if (!force && Date.now() - state.lastCheck < MIN_GAP_MS) return
+  const base = activeBackend()
+  if (!base) return
+  set({ lastCheck: Date.now() })
+  try {
+    const res = await fetch(`${base}/api/app/update?vc=${info.versionCode}&bv=${info.bundleVersion}`, {
+      cache: 'no-store',
+    })
+    if (!res.ok) return
+    const body = await res.json()
+    const d = (body && body.data) || {}
+    if (Array.isArray(d.endpoints)) setRemoteEndpoints(d.endpoints)
+    set({ apk: d.apk || null, bundle: d.bundle || null })
+    if (d.bundle && state.bundleStatus !== 'downloading' && state.bundleStatus !== 'ready') {
+      startBundleDownload()
+    }
+  } catch {
+    /* offline / server busy — try again next time */
+  }
+}
+
+export function startBundleDownload() {
+  const n = native()
+  const b = state.bundle
+  if (!n || !b) return
+  set({ bundleStatus: 'downloading' })
+  try {
+    n.downloadBundle(absolute(b.url), b.sha256 || '', b.version | 0)
+  } catch {
+    set({ bundleStatus: 'error' })
+  }
+}
+
+export function startApkDownload() {
+  const n = native()
+  const a = state.apk
+  if (!n || !a) return
+  set({ apkStatus: 'downloading', apkPct: 0 })
+  try {
+    n.downloadApk(absolute(a.url), a.sha256 || '', a.version_code | 0)
+  } catch {
+    set({ apkStatus: 'error' })
+  }
+}
+
+export function applyBundle() {
+  try {
+    native()?.applyBundle()
+  } catch {
+    /* ignore */
+  }
+}
+
+// Called once the new UI has mounted — lets native cancel its rollback guard.
+export function markBootOk() {
+  try {
+    native()?.markBootOk()
+  } catch {
+    /* ignore */
+  }
+}
+
+// ---------------------------------------------------------------- UI helpers
+export function currentNoticeKey() {
+  if (state.apk) return `apk:${state.apk.version_code}`
+  if (state.bundleStatus === 'ready' && state.bundle) return `bundle:${state.bundle.version}`
+  return ''
+}
+
+export function dismissNotice() {
+  const k = currentNoticeKey()
+  if (k) lsSet(DISMISSED_KEY, k)
+  window.dispatchEvent(new CustomEvent(EVENT))
+}
+
+export function isDismissed() {
+  const k = currentNoticeKey()
+  return !!k && lsGet(DISMISSED_KEY) === k
+}
+
+export function markNoticeSeen() {
+  const k = currentNoticeKey()
+  if (k) lsSet(SEEN_KEY, k)
+  window.dispatchEvent(new CustomEvent(EVENT))
+}
+
+export function hasUnseenNotice() {
+  const k = currentNoticeKey()
+  return !!k && lsGet(SEEN_KEY) !== k
+}
+
+// ---------------------------------------------------------------- scheduler
+let started = false
+export function startUpdateChecks() {
+  if (started || !native()) return
+  started = true
+  checkForUpdate(true)
+  window.setInterval(() => checkForUpdate(true), CHECK_EVERY_MS)
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'visible') checkForUpdate(false)
+  })
+}
diff -ruN -x node_modules -x __pycache__ orig/A501-main/frontend/src/lib/useUpdate.js a501src/A501-main/frontend/src/lib/useUpdate.js
--- orig/A501-main/frontend/src/lib/useUpdate.js	1970-01-01 00:00:00.000000000 +0000
+++ a501src/A501-main/frontend/src/lib/useUpdate.js	2026-11-04 08:17:59.095833519 +0000
@@ -0,0 +1,27 @@
+import { useEffect, useState } from 'react'
+import {
+  UPDATE_EVENT,
+  getUpdateState,
+  hasUnseenNotice,
+  isDismissed,
+  currentNoticeKey,
+} from './updateStore'
+
+// Re-renders whenever the update state changes. `notice` is true while
+// there is something the user should hear about (a new APK, or a UI update
+// that finished downloading), `dismissed` means they already tapped "Later".
+export function useUpdate() {
+  const [, bump] = useState(0)
+  useEffect(() => {
+    const on = () => bump((n) => n + 1)
+    window.addEventListener(UPDATE_EVENT, on)
+    return () => window.removeEventListener(UPDATE_EVENT, on)
+  }, [])
+  const s = getUpdateState()
+  return {
+    ...s,
+    notice: !!currentNoticeKey(),
+    unseen: hasUnseenNotice(),
+    dismissed: isDismissed(),
+  }
+}
