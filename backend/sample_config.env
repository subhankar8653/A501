# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
USER_SESSION_STRING=""

# Phone bots (on-device TDLib) — REQUIRED for the Android app's direct streaming.
# Comma-separated tokens of dedicated "phone bots" (create several in BotFather,
# NOT your main BOT_TOKEN). Add each one as an admin (all permissions off) to the
# storage channel(s) so it can read the files. The app receives one of these,
# never BOT_TOKEN. More bots = more phones supported without flood/session limits.
# If a token leaks: revoke it in BotFather, replace it here — no app update needed.
PHONE_BOT_TOKENS=""
# Max distinct devices per API token per 24h, and config requests per hour.
PHONE_MAX_DEVICES_PER_TOKEN="3"
PHONE_CONFIG_RATE_PER_HOUR="30"
# Emergency only (insecure): let phones use the MAIN bot when no pool exists.
# ALLOW_MAIN_BOT_FOR_PHONES="false"
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# Google Drive (optional): official Drive API v3 key — enable "Google Drive API"
# in Google Cloud Console, create an API key. When set, Drive streams proxy
# through this backend via the official alt=media endpoint (no black-screen
# IP-lock issue). Drive files must be shared "Anyone with the link".
# Leave empty to keep using the old GDRIVE_RESOLVER_BASE redirect method.
GDRIVE_API_KEY=""

# Capacity tuning for small servers (defaults sized for ~1GB RAM / 2 cores).
# MAX_CONCURRENT_STREAMS: max viewers actively receiving bytes at once — past
#   this, new requests wait a few seconds then get a clean 503, instead of
#   the server running out of RAM. Raise this only after checking real RAM
#   headroom on your box (watch memory usage under load, don't guess).
# MAX_STREAM_PARALLELISM: max simultaneous Telegram chunk-fetches a SINGLE
#   viewer's stream may use (lower = more viewers fit, each buffers a bit
#   slower). Was hardcoded to 5 before; 2 is a safer default for 1GB RAM.
MAX_CONCURRENT_STREAMS="40"
MAX_STREAM_PARALLELISM="2"

# Huka Tube app "Sign up with Telegram" flow: chat id of a channel/group
# where a log message gets posted every time someone signs up in the app
# (name, username, Telegram id, time). Leave blank to disable.
APP_SIGNUP_LOG_CHANNEL=""
