# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
USER_SESSION_STRING=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# Google Drive (optional): official Drive API v3 key — enable "Google Drive API"
# in Google Cloud Console, create an API key. When set, Drive streams proxy
# through this backend via the official alt=media endpoint (no black-screen
# IP-lock issue). Drive files must be shared "Anyone with the link".
# Leave empty to keep using the old GDRIVE_RESOLVER_BASE redirect method.
GDRIVE_API_KEY=""

# Capacity tuning for small servers (defaults sized for ~1GB RAM / 2 cores).
# MAX_CONCURRENT_STREAMS: max viewers actively receiving bytes at once — past
#   this, new requests wait a few seconds then get a clean 503, instead of
#   the server running out of RAM. Raise this only after checking real RAM
#   headroom on your box (watch memory usage under load, don't guess).
# MAX_STREAM_PARALLELISM: max simultaneous Telegram chunk-fetches a SINGLE
#   viewer's stream may use (lower = more viewers fit, each buffers a bit
#   slower). Was hardcoded to 5 before; 2 is a safer default for 1GB RAM.
MAX_CONCURRENT_STREAMS="40"
MAX_STREAM_PARALLELISM="2"
